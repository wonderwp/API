{
  "name": "wonderwp/api",
  "description": "WonderWp Api Component",
  "type": "library",
  "keywords": ["api","WonderWp","WordPress"],
  "homepage": "https://github.com/wonderwp/API",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3",
    "wonderwp/service": "dev-feature/php_8",
    "wonderwp/http-foundation": "dev-feature/increase_http_foundation_lib_version"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"WonderWp\\Component\\API\\": "src"},
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WonderWp\\Component\\API\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "minimum-stability": "dev"
}
